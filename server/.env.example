# Copy to .env for local overrides, or set these in your host's dashboard
# (e.g. Render) for a deployed instance. None of these are required for
# local development — sensible defaults are used instead.

# Local Postgres connection string. Omit this for local dev (a local
# Postgres on localhost:5432 is assumed). Set this in production to your
# hosted Postgres (e.g. Supabase's "Connection string" from
# Project Settings > Database).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs login cookies. Required in production — use a long random string.
# Render's Blueprint (render.yaml) auto-generates this for you.
# JWT_SECRET=change-me-to-a-long-random-string

# The frontend's URL, so the backend allows it to make authenticated
# requests. Required in production.
# CLIENT_ORIGIN=https://your-app.onrender.com

# Set NODE_ENV=production in production — it changes the login cookie's
# security settings to work across two different domains (frontend/backend
# hosted separately).
# NODE_ENV=production

# Photo storage. Omit both for local dev (photos are saved to server/uploads
# instead). Required in production — see README for how to get these from
# your Supabase project (Project Settings > API).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
